---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { buildSiteContent, withBase } from '../lib/content';
import { getIcon } from '../lib/icons';
import { ChevronRight, FileText, Search } from 'lucide-astro';

const site = await buildSiteContent();
const documentCount = site.courses.reduce((acc, course) => acc + course.totalDocuments, 0);
---

<BaseLayout description={SITE.description}>
  <div class="space-y-10">
    <header class="max-w-2xl">
      <h1 class="text-balance text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">Probability and Statistics</h1>
      <p class="mt-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
        {site.courses.length} course {site.courses.length === 1 ? '' : 's'} · {documentCount}
        document{documentCount === 1 ? '' : 's'}
      </p>
      <a
        href={withBase('search/')}
        class="mt-4 inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-indigo-300 hover:text-indigo-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-indigo-500 dark:hover:text-indigo-300"
      >
        <Search size={15} class="text-slate-400 dark:text-slate-500" />
        Search all notes
      </a>
    </header>
    <div class="grid gap-5 md:grid-cols-2">
      {
        site.courses.map((course) => {
          const Icon = getIcon(course.icon);
          return (
            <section class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-800 dark:bg-slate-900">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
                  <Icon size={20} />
                </span>
                <div class="min-w-0">
                  <h2 class="line-clamp-2 break-words text-base font-semibold text-slate-900 dark:text-slate-100">{course.title}</h2>
                  <p class="text-xs text-slate-500 dark:text-slate-400">
                    {course.sections.length} section{course.sections.length === 1 ? '' : 's'} ·{' '}
                    {course.totalDocuments} document{course.totalDocuments === 1 ? '' : 's'}
                  </p>
                </div>
                <a
                  href={course.href}
                  class="ml-auto inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-indigo-600 dark:hover:bg-slate-800"
                  aria-label={`Open the ${course.title} course index`}
                >
                  <ChevronRight size={16} />
                </a>
              </div>
              {course.description && (
                <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{course.description}</p>
              )}
              <div class="mt-4 space-y-3">
                {course.sections.map((section) => (
                  <div>
                    <p class="pb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                      {section.label}
                    </p>
                    <ul>
                      {section.items.map((item) => (
                        <li class="border-b border-slate-100 last:border-0 dark:border-slate-800">
                          <a
                            href={item.href}
                            class="group flex items-center gap-2 py-2 text-sm font-medium text-slate-700 transition-colors hover:text-indigo-700 dark:text-slate-200"
                          >
                            <FileText size={14} class="shrink-0 text-slate-400 group-hover:text-indigo-500 dark:text-slate-600" />
                            <span class="min-w-0 line-clamp-2">{item.title}</span>
                            <ChevronRight
                              size={14}
                              class="ml-auto shrink-0 text-slate-300 group-hover:text-indigo-500 dark:text-slate-600"
                            />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {course.sections.length === 0 && (
                  <p class="rounded-lg border border-dashed border-slate-200 py-3 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
                    Coming soon.
                  </p>
                )}
              </div>
            </section>
          );
        })
      }
      {
        site.courses.length === 0 && (
          <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-center sm:p-10 md:col-span-2 dark:border-slate-700">
            <p class="text-sm text-slate-600 dark:text-slate-300">
              No courses yet. Create a folder under{' '}
              <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs dark:bg-slate-800">content/courses/</code>{' '}
              and add Markdown files — they appear here automatically.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
