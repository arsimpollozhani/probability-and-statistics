---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildSiteContent } from '../lib/content';
import { Search } from 'lucide-astro';

const site = await buildSiteContent();
const indexJson = JSON.stringify(site.searchIndex);
---

<BaseLayout title="Search" description="Search all lecture notes, tutorials and problem sets.">
  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <h1 class="flex items-center gap-2.5 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
          <Search size={19} />
        </span>
        Search notes
      </h1>
      <p class="mt-3 text-[15px] text-slate-600 dark:text-slate-300">
        {site.searchIndex.length} documents indexed — titles, descriptions and tags.
      </p>
    </header>

    <!-- Build-time index; regenerated whenever content changes -->
    <script
      id="search-index"
      is:inline
      type="application/json"
      set:html={indexJson}
    />

    <div class="relative">
      <Search size={17} class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500" />
      <input
        id="search-input"
        type="search"
        placeholder="Type to filter… (e.g. limit, SQL, estimation)"
        autocomplete="off"
        class="w-full rounded-xl border border-slate-300 bg-white px-10 py-3 text-[15px] text-slate-900 shadow-sm outline-none transition-colors placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-indigo-500 dark:focus:ring-indigo-500/20"
      />
    </div>

    <div id="search-status" class="mt-3 text-[13px] text-slate-500 dark:text-slate-400"></div>

    <ul id="search-results" class="mt-4 space-y-2">
      {
        site.searchIndex.map((item) => (
          <li data-haystack={`${item.title} ${item.summary ?? ''} ${item.tags.join(' ')} ${item.courseTitle} ${item.typeLabel}`.toLowerCase()}>
            <a
              href={item.href}
              class="group flex items-baseline gap-x-3 rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-indigo-300 hover:bg-indigo-50/40 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500 dark:hover:bg-indigo-500/10"
            >
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-slate-900 group-hover:text-indigo-700 dark:text-slate-100 dark:group-hover:text-indigo-300">
                  {item.title}
                </span>
                <span class="mt-0.5 block text-xs font-medium text-slate-400 dark:text-slate-500">
                  {item.courseTitle} · {item.typeLabel}
                  {item.tags.length > 0 && ` · ${item.tags.map((tag) => `#${tag}`).join(' ')}`}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const list = document.getElementById('search-results');
    const indexScript = document.getElementById('search-index');

    const items: { title: string; courseTitle: string; typeLabel: string; href: string }[] =
      indexScript ? JSON.parse(indexScript.textContent ?? '[]') : [];

    function render(query: string): void {
      if (!list || !status) return;
      const q = query.trim().toLowerCase();
      if (!q) {
        status!.textContent = `Showing all ${items.length} documents`;
        for (const li of list.children) {
          (li as HTMLElement).hidden = false;
        }
        return;
      }
      const terms = q.split(/\s+/);
      let shown = 0;
      for (const li of list.children) {
        const haystack =
          (li as HTMLElement).dataset.haystack ?? (li as HTMLElement).textContent ?? '';
        const match = terms.every((term) => haystack.includes(term));
        (li as HTMLElement).hidden = !match;
        if (match) shown += 1;
      }
      status!.textContent = shown === 0 ? `No documents match “${query.trim()}”` : `${shown} document${shown === 1 ? '' : 's'} match “${query.trim()}”`;
    }

    input?.addEventListener('input', () => render(input.value));
    render('');
  </script>
</BaseLayout>
