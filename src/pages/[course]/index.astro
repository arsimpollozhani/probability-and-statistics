---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSiteContent, withBase } from '../../lib/content';
import { getIcon } from '../../lib/icons';
import { ChevronRight, ChevronLeft, FileText } from 'lucide-astro';

export async function getStaticPaths() {
  const site = await buildSiteContent();
  return site.courses.map((course) => ({
    params: { course: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const CourseIcon = getIcon(course.icon);
---

<BaseLayout title={`${course.title}`} description={course.description}>
  <div class="mx-auto max-w-3xl space-y-10">
    <header class="border-b border-slate-200 pb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-[13px]">
        <a
          href={withBase('')}
          class="font-medium text-slate-500 transition-colors hover:text-indigo-600"
          >Home</a
        >
        <ChevronRight size={13} class="text-slate-300" />
        <span class="font-medium text-indigo-600">{course.title}</span>
      </nav>
      <div class="mt-4 flex items-center gap-3">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"
        >
          <CourseIcon size={21} />
        </span>
        <h1 class="min-w-0 break-words text-balance text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">{course.title}</h1>
      </div>
      {course.description && (
        <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">{course.description}</p>
      )}
      <p class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
        {
          course.sections.map((section) => (
            <a
              href={`#${section.folder}`}
              class="rounded-full bg-slate-100 px-2.5 py-1 font-medium hover:bg-indigo-50 hover:text-indigo-700 dark:bg-slate-800 dark:hover:bg-indigo-500/10 dark:hover:text-indigo-300"
            >
              {section.label} ({section.items.length})
            </a>
          ))
        }
      </p>
    </header>

    {
      course.sections.length > 0 && (
        <div class="space-y-10">
          {course.sections.map((section) => {
            const Icon = getIcon(section.icon);
            return (
              <section id={section.folder} class="scroll-mt-10">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    <Icon size={14} />
                  </span>
                  {section.label}
                  <span class="text-xs font-normal text-slate-400 dark:text-slate-500">
                    {section.items.length} document{section.items.length === 1 ? '' : 's'}
                  </span>
                </h2>
                <ul
                  class:list={['mt-4 grid gap-3', section.items.length > 2 && 'sm:grid-cols-2']}
                >
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-indigo-300 hover:bg-indigo-50/40 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500 dark:hover:bg-indigo-500/10"
                      >
                        <span class="min-w-0 text-sm font-semibold text-slate-900 group-hover:text-indigo-700 dark:text-slate-100 dark:group-hover:text-indigo-300">
                          {item.title}
                        </span>
                        {item.summary && (
                          <span class="mt-1 line-clamp-2 text-[13px] leading-relaxed text-slate-600 dark:text-slate-300">
                            {item.summary}
                          </span>
                        )}
                        {item.tags.length > 0 && (
                          <span class="mt-auto flex flex-wrap gap-1.5 pt-3 text-[10px] font-medium text-slate-500 dark:text-slate-400">
                            {item.tags.map((tag) => (
                              <span class="rounded-full bg-slate-100 px-2 py-0.5 dark:bg-slate-800">#{tag}</span>
                            ))}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
          <p>
            <a
              href={course.sections[0]?.items[0]?.href}
              class="group inline-flex items-center gap-2 text-sm font-semibold text-indigo-700 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
            >
              <ChevronLeft size={15} />
              Start with the first document
            </a>
          </p>
        </div>
      )
    }

    {
      course.sections.length === 0 && (
        <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-center sm:p-12 dark:border-slate-700">
          <p class="text-sm font-medium text-slate-700 dark:text-slate-200">No documents yet.</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">
            Add Markdown files under{' '}
            <code class="break-words rounded bg-slate-100 px-1.5 py-0.5 text-xs dark:bg-slate-800"
              >content/courses/{course.id}/&lbrace;lectures,tutorials,problems,reference&rbrace;/</code
            >
            — they are discovered automatically on the next build.
          </p>
          <p class="mt-4 flex items-center justify-center gap-2 text-xs text-slate-400 dark:text-slate-500">
            <FileText size={13} />
            Course data from <span class="font-mono">course.yaml</span>
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
