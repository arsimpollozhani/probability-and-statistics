---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/content';
---

<BaseLayout title="Page not found">
  <div class="flex flex-col items-center py-24 text-center">
    <p class="text-6xl font-bold text-indigo-600/90 dark:text-indigo-400/90">404</p>
    <h1 class="mt-4 text-xl font-semibold text-slate-900 dark:text-slate-100">This lecture does not exist</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      The page you are looking for was moved, renamed, or never existed.
    </p>
    <a
      href={withBase('')}
      class="mt-6 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500"
    >
      Back to all lectures
    </a>
  </div>
</BaseLayout>
